{
  "name": "html-flow-board",
  "version": "0.4.0",
  "description": "Standalone JS+CSS library to create interactive storyboards with screens connected by SVG arrows",
  "main": "flowboard.js",
  "style": "flowboard.css",
  "bin": "scripts/install-skill.mjs",
  "files": [
    "flowboard.js",
    "flowboard.min.js",
    "flowboard.css",
    "skills",
    "scripts/install-skill.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "concurrently -k \"node scripts/dev-watch.cjs\" \"serve . -l 3000\"",
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh",
    "pretest": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run"
  },
  "keywords": [
    "storyboard",
    "flowchart",
    "wireframe",
    "svg",
    "drag-and-drop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/snowpact/html-flow-board.git"
  },
  "homepage": "https://snowpact.github.io/html-flow-board",
  "bugs": {
    "url": "https://github.com/snowpact/html-flow-board/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.0",
    "jsdom": "^28.1.0",
    "serve": "^14.2.4",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  }
}
